{
  "name": "smart-school-management-software",
  "version": "1.0.0",
  "description": "This Application is developed by Ikramul ALam Chowdhury",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "desktop",
    "app",
    "management",
    "admin",
    "tcsac"
  ],
  "author": "Ikramul Alam Chowdhury",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.tcsac.schoolmanagement",
    "productName": "Smart School Management Software",
    "directories": {
      "output": "D:/Users/Ikramul/TCSAC",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!sample data/*",
      "!transcript samples/*",
      "!project text/*",
      "!flowcharts/*",
      "!school.db"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart School Management",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
