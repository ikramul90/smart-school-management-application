{
  "name": "edukit-campus",
  "version": "1.0.0",
  "description": "EduKit Campus by EduKit Solutions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "desktop",
    "app",
    "management",
    "admin",
    "EduKit Campus", 
    "EduKit Solutions",
    "EduKit"
  ],
  "author": "Ikramul Alam Chowdhury",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.edukitsolutions.campus",
    "copyright": "Copyright © 2026 EduKit Solutions",
    "extraResources": [
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "productName": "Edukit Campus",
    "directories": {
      "output": "D:/Users/Ikramul/TCSAC",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!sample data/*",
      "!transcript samples/*",
      "!project text/*",
      "!flowcharts/*",
      "!school.db"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduKit Campus",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",  
      "license": "build/eula.rtf"
    }
  }
}
